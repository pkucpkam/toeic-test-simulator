# PostgreSQL Database Configuration
# Local Postgres:
# DB_URL=jdbc:postgresql://localhost:5432/toeic
# DB_USERNAME=postgres
# DB_PASSWORD=123

# Aiven PostgreSQL Example (SSL is required by Aiven):
# DB_URL=jdbc:postgresql://pg-xxxx-your-host.aivencloud.com:12345/defaultdb?sslmode=require
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_aiven_password

DB_URL=jdbc:postgresql://localhost:5432/toeic
DB_USERNAME=postgres
DB_PASSWORD=123

# JWT Security
JWT_SECRET=your_secret_key_here

# CORS
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Server config
# PORT=8080
# SQL_INIT_MODE=always

# Media config
# media.strategy=local (default) or drive
# media.local.path=../../data/downloads
